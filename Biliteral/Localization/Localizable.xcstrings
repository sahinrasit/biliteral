    "Apple Intelligence couldn't explain this sentence. It may not support this language yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence konnte diesen Satz nicht erklären. Diese Sprache wird eventuell noch nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n’a pas pu expliquer cette phrase. Cette langue n’est peut-être pas encore prise en charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no ha podido explicar esta frase. Puede que aún no admita este idioma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence non è riuscita a spiegare questa frase. Forse questa lingua non è ancora supportata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kon deze zin niet uitleggen. Deze taal wordt mogelijk nog niet ondersteund."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence bu cümleyi açıklayamadı. Bu dil henüz desteklenmiyor olabilir."
          }
        }
      }
    },
