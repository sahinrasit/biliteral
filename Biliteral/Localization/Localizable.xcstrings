    "Two pages are used on wide screens: iPad, an unfolded phone or a large iPhone in landscape.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Seiten werden auf breiten Bildschirmen genutzt: iPad, aufgeklapptes Telefon oder ein großes iPhone im Querformat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux pages s’affichent sur les grands écrans : iPad, téléphone déplié ou grand iPhone à l’horizontale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos páginas se usan en pantallas anchas: iPad, un teléfono desplegado o un iPhone grande en horizontal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le due pagine si usano sugli schermi larghi: iPad, telefono aperto o un iPhone grande in orizzontale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee pagina’s worden gebruikt op brede schermen: iPad, een opengevouwen telefoon of een grote iPhone in liggende stand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki sayfa geniş ekranlarda kullanılır: iPad, açılmış katlanabilir telefon veya yatay tutulan büyük iPhone."
