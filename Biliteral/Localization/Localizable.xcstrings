    "Import a DRM-free EPUB or PDF, a web article or any text. Translation happens on your device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere ein EPUB oder PDF ohne DRM, einen Webartikel oder beliebigen Text. Die Übersetzung passiert auf deinem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un EPUB ou un PDF sans DRM, un article web ou n’importe quel texte. La traduction se fait sur votre appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un EPUB o PDF sin DRM, un artículo web o cualquier texto. La traducción se hace en tu dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un EPUB o PDF senza DRM, un articolo web o qualsiasi testo. La traduzione avviene sul tuo dispositivo."
          }
        },
        "nl": {
