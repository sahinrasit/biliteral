          }
        }
      }
    },
    "Translation into %@ isn't available right now. Download the language in Settings › Apps › Translate › Downloaded Languages, or connect to the internet once and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung (%@) ist gerade nicht verfügbar. Lade die Sprache unter Einstellungen › Apps › Übersetzen › Geladene Sprachen oder verbinde dich einmal mit dem Internet und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction (%@) n’est pas disponible pour le moment. Téléchargez la langue dans Réglages › Apps › Traduire › Langues téléchargées, ou connectez-vous une fois à Internet et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción (%@) no está disponible ahora. Descarga el idioma en Ajustes › Apps › Traducir › Idiomas descargados, o conéctate a internet una vez y vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione (%@) non è disponibile al momento. Scarica la lingua in Impostazioni › App › Traduci › Lingue scaricate, oppure connettiti a Internet una volta e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertalen (%@) is nu niet beschikbaar. Download de taal via Instellingen › Apps › Vertaal › Gedownloade talen, of maak één keer verbinding met internet en probeer het opnieuw."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri (%@) şu anda kullanılamıyor. Dili Ayarlar › Uygulamalar › Çeviri › İndirilen Diller bölümünden indir veya bir kez internete bağlanıp tekrar dene."
          }
        }
      }
    },
    "Translation runs on your device, so nothing you read is uploaded. Open DRM-free EPUB and PDF files, web articles or pasted text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung läuft auf deinem Gerät, nichts, was du liest, wird hochgeladen. Öffne EPUB- und PDF-Dateien ohne DRM, Webartikel oder eingefügten Text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction se fait sur votre appareil : rien de ce que vous lisez n’est envoyé. Ouvrez des EPUB et PDF sans DRM, des articles web ou du texte collé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción se hace en tu dispositivo, así que nada de lo que lees se sube. Abre EPUB y PDF sin DRM, artículos web o texto pegado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione avviene sul tuo dispositivo, quindi nulla di ciò che leggi viene caricato. Apri EPUB e PDF senza DRM, articoli web o testo incollato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vertaling gebeurt op je toestel, dus niets wat je leest wordt geüpload. Open EPUB- en PDF-bestanden zonder DRM, webartikelen of geplakte tekst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri cihazında yapılır, okuduğun hiçbir şey yüklenmez. DRM'siz EPUB ve PDF dosyalarını, web makalelerini veya yapıştırdığın metni aç."
          }
        }
      }
    },
    "Translation runs on your device. Nothing you read is uploaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung läuft auf deinem Gerät. Nichts, was du liest, wird hochgeladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction se fait sur votre appareil. Rien de ce que vous lisez n’est envoyé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción se hace en tu dispositivo. Nada de lo que lees se sube."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione avviene sul tuo dispositivo. Nulla di ciò che leggi viene caricato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vertaling gebeurt op je toestel. Niets wat je leest wordt geüpload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri cihazında yapılır. Okuduğun hiçbir şey yüklenmez."
          }
        }
      }
    },
    "Translation runs on your device. The first time you use a language pair, iOS asks to download it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung läuft auf deinem Gerät. Beim ersten Mal fragt iOS, ob das Sprachpaar geladen werden soll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction se fait sur votre appareil. La première fois qu’une paire de langues est utilisée, iOS propose de la télécharger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción se hace en tu dispositivo. La primera vez que uses un par de idiomas, iOS te pedirá descargarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione avviene sul tuo dispositivo. La prima volta che usi una coppia di lingue, iOS chiede di scaricarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vertaling gebeurt op je toestel. De eerste keer dat je een taalpaar gebruikt, vraagt iOS om het te downloaden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri cihazında yapılır. Bir dil çiftini ilk kullandığında iOS indirmek için izin ister."
          }
        }
      }
    },
