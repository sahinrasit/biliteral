    "While reading, tap a sentence, then tap a word you don't know and choose “I don't know this word”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe beim Lesen auf einen Satz, dann auf ein unbekanntes Wort und wähle „Dieses Wort kenne ich nicht“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En lisant, touchez une phrase, puis un mot inconnu, et choisissez « Je ne connais pas ce mot »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras lees, toca una frase, luego una palabra que no conozcas y elige «No conozco esta palabra»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre leggi, tocca una frase, poi una parola che non conosci e scegli «Non conosco questa parola»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik tijdens het lezen op een zin, dan op een onbekend woord, en kies ‘Dit woord ken ik niet’."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okurken bir cümleye, sonra bilmediğin bir kelimeye dokun ve “Bu kelimeyi bilmiyorum”u seç."
          }
        }
      }
    },
    "You reviewed %lld cards. Keep reading to find new words.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You reviewed %lld card. Keep reading to find new words."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You reviewed %lld cards. Keep reading to find new words."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Du hast %lld Karte wiederholt. Lies weiter, um neue Wörter zu entdecken."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Du hast %lld Karten wiederholt. Lies weiter, um neue Wörter zu entdecken."
