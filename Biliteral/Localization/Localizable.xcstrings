          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun texte lisible n’a été trouvé. Les PDF numérisés sans couche de texte ne sont pas encore pris en charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado texto legible. Los PDF escaneados sin capa de texto aún no son compatibles."
