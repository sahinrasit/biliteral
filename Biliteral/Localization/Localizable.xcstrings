            "value": "Kendi kitabın. İki dil."
          }
        }
      }
    },
    "Your books, translated on your device. Pay once, keep it forever.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bücher, übersetzt auf deinem Gerät. Einmal zahlen, für immer behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos livres, traduits sur votre appareil. Payez une fois, gardez-le pour toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus libros, traducidos en tu dispositivo. Paga una vez y es tuyo para siempre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi libri, tradotti sul tuo dispositivo. Paghi una volta, tuo per sempre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je boeken, vertaald op je toestel. Eén keer betalen, voor altijd van jou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitapların, cihazında çevrilir. Bir kez öde, sonsuza dek senin."
          }
        }
      }
    },
    "Your device can't translate %@ to %@. Choose another language pair in Aa.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gerät kann dieses Sprachpaar nicht übersetzen (%1$@ → %2$@). Wähle unter Aa ein anderes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appareil ne peut pas traduire cette paire de langues (%1$@ → %2$@). Choisissez-en une autre dans Aa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo no puede traducir este par de idiomas (%1$@ → %2$@). Elige otro en Aa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo dispositivo non può tradurre questa coppia di lingue (%1$@ → %2$@). Scegline un’altra in Aa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je toestel kan dit taalpaar niet vertalen (%1$@ → %2$@). Kies een ander via Aa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazın bu dil çiftini çeviremiyor (%1$@ → %2$@). Aa menüsünden başka bir çift seç."
          }
        }
      }
    },
    "Your device can't translate between these languages. Choose another pair.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gerät kann zwischen diesen Sprachen nicht übersetzen. Wähle ein anderes Paar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appareil ne peut pas traduire entre ces langues. Choisissez une autre paire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo no puede traducir entre estos idiomas. Elige otro par."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo dispositivo non può tradurre tra queste lingue. Scegli un’altra coppia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je toestel kan niet tussen deze talen vertalen. Kies een ander paar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazın bu diller arasında çeviri yapamıyor. Başka bir çift seç."
          }
        }
      }
    },
