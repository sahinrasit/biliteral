            "state": "translated",
            "value": "Votre livre. Deux langues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu libro. Dos idiomas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo libro. Due lingue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw boek. Twee talen."
          }
        },
        "tr": {
