    "iOS will ask to download this language pair once. After that, translation works offline.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt einmal, ob dieses Sprachpaar geladen werden soll. Danach funktioniert die Übersetzung offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS proposera une fois de télécharger cette paire de langues. Ensuite, la traduction fonctionne hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS te pedirá una vez descargar este par de idiomas. Después, la traducción funciona sin conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chiederà una volta di scaricare questa coppia di lingue. Dopo, la traduzione funziona offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vraagt één keer om dit taalpaar te downloaden. Daarna werkt vertalen offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bu dil çiftini bir kez indirmek için izin ister. Sonrasında çeviri çevrimdışı çalışır."
          }
        }
      }
    },
