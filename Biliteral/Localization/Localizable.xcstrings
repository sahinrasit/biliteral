    "Biliteral keeps the article text and drops menus and ads. Articles behind a paywall or login can't be loaded; paste their text instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biliteral behält den Artikeltext und entfernt Menüs und Werbung. Artikel hinter einer Paywall oder einem Login können nicht geladen werden; füge ihren Text stattdessen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biliteral garde le texte de l’article et retire menus et publicités. Les articles derrière un paywall ou une connexion ne peuvent pas être chargés ; collez plutôt leur texte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Biliteral conserva el texto del artículo y quita menús y anuncios. Los artículos de pago o con inicio de sesión no se pueden cargar; pega su texto en su lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Biliteral conserva il testo dell’articolo e rimuove menu e pubblicità. Gli articoli a pagamento o con accesso non possono essere caricati; incolla invece il loro testo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biliteral houdt de artikeltekst en laat menu’s en advertenties weg. Artikelen achter een betaalmuur of login kunnen niet worden geladen; plak dan hun tekst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biliteral makale metnini alır, menüleri ve reklamları atar. Ücretli veya giriş gerektiren makaleler yüklenemez; bunun yerine metnini yapıştır."
          }
        }
      }
    },
