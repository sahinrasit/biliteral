# App Store Connect API key: fastlane/asc_api_key.json (git-ignored)
#   { "key_id": "...", "issuer_id": "...", "key_filepath": "AuthKey_XXXX.p8" }
default_platform(:ios)

APP_ID = "com.sahinrasit.biliteral"

def asc_config
  path = File.expand_path("asc_api_key.json", __dir__)
  UI.user_error!("Missing fastlane/asc_api_key.json") unless File.exist?(path)
  JSON.parse(File.read(path))
end

def asc_key
  cfg = asc_config
  app_store_connect_api_key(key_id: cfg["key_id"], issuer_id: cfg["issuer_id"],
                            key_filepath: File.expand_path(cfg["key_filepath"], __dir__), in_house: false)
end

def signing_xcargs
  cfg = asc_config
  "-allowProvisioningUpdates -authenticationKeyPath #{File.expand_path(cfg['key_filepath'], __dir__)} " \
    "-authenticationKeyID #{cfg['key_id']} -authenticationKeyIssuerID #{cfg['issuer_id']}"
end

platform :ios do
  desc "Unit and UI tests"
  lane :tests do
    run_tests(project: "Biliteral.xcodeproj", scheme: "Biliteral", devices: ["Biliteral iPhone 17 Pro Max"], result_bundle: true)
  end

  desc "Register the bundle ID and create the App Store Connect record"
  lane :create_app do
    key = asc_key
    produce(api_key: key, app_identifier: APP_ID, app_name: "Biliteral: Bilingual Reader",
            language: "English", sku: "biliteral-ios-2026", app_version: "1.0",
            enable_services: { in_app_purchase: "on" })
  end

  desc "App Store screenshots for every locale"
  lane :screenshots do
    capture_screenshots
  end

  desc "Upload metadata (and screenshots, if present) without a binary"
  lane :metadata do
    deliver(api_key: asc_key, app_identifier: APP_ID, skip_binary_upload: true,
            skip_screenshots: !Dir.exist?(File.expand_path("screenshots/en-US", __dir__)),
            overwrite_screenshots: true, force: true, run_precheck_before_submit: false,
            precheck_include_in_app_purchases: false)
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    key = asc_key
    latest = latest_testflight_build_number(api_key: key, app_identifier: APP_ID, initial_build_number: 0)
    # fastlane's xcodeproj gem can't parse the XcodeGen project (local Swift package), so
    # archive and export with xcodebuild directly and pass the build number as a setting.
    root = File.expand_path("..", __dir__)
    archive = "#{root}/build/release/Biliteral.xcarchive"
    export_dir = "#{root}/build/release/export"
    plist = "#{root}/build/release/ExportOptions.plist"
    FileUtils.rm_rf(["#{root}/build/release"])
    FileUtils.mkdir_p(export_dir)
    File.write(plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict>
        <key>method</key><string>app-store-connect</string>
        <key>teamID</key><string>CJ438MY6FU</string>
        <key>signingStyle</key><string>automatic</string>
        <key>uploadSymbols</key><true/>
        <key>destination</key><string>export</string>
      </dict></plist>
    PLIST
    sh("set -o pipefail && cd #{root} && xcodebuild archive -project Biliteral.xcodeproj -scheme Biliteral -configuration Release " \
       "-destination generic/platform=iOS -archivePath #{archive} #{signing_xcargs} " \
       "CURRENT_PROJECT_VERSION=#{latest + 1} | tail -5")
    sh("set -o pipefail && xcodebuild -exportArchive -archivePath #{archive} -exportPath #{export_dir} " \
       "-exportOptionsPlist #{plist} #{signing_xcargs} | tail -5")
    ipa = Dir["#{export_dir}/*.ipa"].first or UI.user_error!("No IPA exported")
    upload_to_testflight(api_key: key, ipa: ipa, skip_waiting_for_build_processing: false, distribute_external: false)
  end

  desc "Submit the latest build for App Review"
  lane :release do
    deliver(api_key: asc_key, app_identifier: APP_ID, skip_binary_upload: true, skip_screenshots: true,
            skip_metadata: false, force: true, submit_for_review: true, automatic_release: false,
            precheck_include_in_app_purchases: false,
            submission_information: { export_compliance_uses_encryption: false, add_id_info_uses_idfa: false })
  end
end
